# Copy to .env.local to develop against the real spreadsheet instead of the
# local mock data. See gas/README.md for how to get these values. Leave
# NEXT_PUBLIC_GAS_URL unset (or delete this file) to keep using the local
# mock data.

# Apps Script Web App URL (ends with /exec). All reads and writes go through it
NEXT_PUBLIC_GAS_URL=
# Google OAuth client ID — required together with NEXT_PUBLIC_GAS_URL
# (sign-in is needed to read any data)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# optional — Google Form response URL (.../formResponse) that the feedback
# screen posts to. Without this, the feedback screen shows that no destination
# is configured and cannot submit
NEXT_PUBLIC_FEEDBACK_FORM_URL=
