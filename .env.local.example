# Copy to .env.local to develop against the real spreadsheet instead of the
# local mock data. See gas/README.md for how to get these URLs. Leave any of
# them unset (or delete this file) to keep using the local mock data.

NEXT_PUBLIC_MEMBERS_CSV=
NEXT_PUBLIC_PROJECTS_CSV=
NEXT_PUBLIC_TASKS_CSV=
NEXT_PUBLIC_GAS_URL=
# optional — syncs the 要求スキル/カテゴリ/権限レベル/プロジェクトテンプレート
# option pools across everyone's browser instead of per-device localStorage
# (see gas/README.md)
NEXT_PUBLIC_SETTINGS_CSV=
# optional — Google OAuth client ID for real Google login and personal Sheets sync
# Without this, login falls back to the demo user picker
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# optional — Google Form response URL (.../formResponse) that the feedback
# screen posts to. Without this, the feedback screen shows that no destination
# is configured and cannot submit
NEXT_PUBLIC_FEEDBACK_FORM_URL=
